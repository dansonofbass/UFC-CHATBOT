NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=openrouter/free
ALLOW_OPENROUTER_FALLBACK=false
UFCALENDAR_API_KEY_1=
UFCALENDAR_API_KEY_2=
UFCALENDAR_API_KEY_3=
UFCALENDAR_ACTIVE_KEY=1
# All keys must belong to the same authorized account. No cross-account quota rotation.
UFCALENDAR_ACCOUNT_ID=primary
UFCALENDAR_MAX_REQUESTS_PER_RUN=3
UFCALENDAR_MONTHLY_LOCAL_LIMIT=80
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=100000
CLIENT_HOURLY_LIMIT=20
INTERNAL_API_TOKEN=
# Only configure feeds you have permission to ingest. JSON array of {url,license}.
NEWS_FEEDS=[]
# Optional local multilingual embeddings; no paid API used.
ENABLE_EMBEDDINGS=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional migration process inputs. Never commit actual values.
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=
# Request-time intelligence defaults on; false retains the rollback path.
CHAT_INTELLIGENCE_ENABLED=true
CHAT_LIVE_RETRIEVAL_ENABLED=true
CHAT_MODEL_UNDERSTANDING_ENABLED=true
CHAT_WEB_SEARCH_ENABLED=false
CHAT_RETRIEVAL_DAILY_LIMIT=1000
CHAT_PROVIDER_REQUEST_LIMIT=6
AI_MAX_OUTPUT_TOKENS=1400
WEB_SEARCH_PROVIDER=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_DAILY_LIMIT=10

# Admin-only console: configure privately in Vercel, never commit real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional model allowlists for Admin selectors (comma separated). Base *_MODEL is included.
GROQ_MODELS=
OPENROUTER_MODELS=
